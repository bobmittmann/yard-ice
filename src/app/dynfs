#define DYNFS_FNAME_MAX 51
#define DYNFS_CACHE_MIN_SIZE 256
#define DYNFS_CACHE_ENTRY_MAX 4
#define DYNFS_CACHE_BLOCK_SIZE_MIN 64
#define DYNFS_CACHE_NUM_BLOCKS 64
#define DYNFS_FILE_OPEN_MAX 1

struct dynfs_dirent {
	uint8_t inode;
	uint8_t flags;
	uint16_t size;
	char fname[DYNFS_FNAME_MAX + 1];
	uint8_t * data;
	int (* generate)(void * arg, char * dst, unsigned int offs, unsigned int size);
};

/* Cache line */
struct dynfs_cache_entry {
	uint8_t offs;
	uint8_t nblk;
	uint8_t rem;
	uint8_t seq;
};

struct dynfs_file {
	const struct dynfs_dirent * dirent;
	void * buf;
	uint32_t len;
};

#define CACHE_BLK_BITS 5
#define CACHE_BLK_SIZE (1 << CACHE_BLK_BITS)
/*
 * [########][######]        [####]
 *
 */

struct chunk_hdr {
	uint16_t size; /* how many block in the chunk */
	uint16_t inode; /* fs back reference */
	uint8_t data[];
};

struct cache_blk {
	union {
		uint8_t u8[CACHE_BLK_SIZE];
		uint32_t u32[CACHE_BLK_SIZE / 4];
		uint64_t u64[CACHE_BLK_SIZE / 8];
		struct chunk_hdr chunk;
	};
};

#define CACHE_CHUNK_MAX (CACHE_BLK_SIZE / sizeof(struct cache_ctl)) 
#define CHUNK_HDR_SIZE (sizeof(struct chunk_hdr)) 

struct cache {
	struct cache_blk * blk;
	uint32_t head;
	uint32_t tail;
	uint16_t mask;

	uint16_t size; /* number of blocks in the cache buffer */
	uint16_t free; /* number of blocks free at the end */
	uint32_t seq;
};

struct dynfs {
	struct cache cache;
	struct dynfs_file file[DYNFS_FILE_OPEN_MAX];
	struct {
		uint8_t cnt;
		uint32_t bmp;
	} file_open;

	const struct dynfs_dirent * dir;
};

void __blkcpy(struct cache * cache, int to, int from)
{
	uint64_t *src = cache->blk[to].u64;
	uint64_t *dst = cache->blk[from].u64;
	int i;
	for (i = 0; i < CACHE_BLK_SIZE/8; ++i)
		dst[i] = src[i];
}

static inline int __bytes2blk(unsigned int bytes)
{
	/* ceiling */
	return (bytes + CACHE_BLK_SIZE + CHUNK_HDR_SIZE - 1) >> CACHE_BLK_BITS;
}

static inline int __blk2offs(struct cache * cache, struct cache_blk * blk)
{
	return blk - cache->blk;
}

/*
 * Cache allocation
 * The blocks are allocated by first releasing enough chunks to 
 * fit the requested size. The free space is then consolidated by
 * relocating them to the top.
 * +=========+
 * |         |
 * |  Alloc  |  
 * |         |
 * +---------+ --------+
 * |  Alloc  |
 * |         |
 * +---------+
 * |  Free   | < offs  |
 * |         |        nblk
 * |         |         |
 *
 * */

int dynfs_init(struct dynfs * fs, const struct dynfs_dirent * dir, 
			   void * cache_buf, size_t cache_size)
{
	int nblk;

	/* ensure nblk is power of 2 */
	nblk = 1 << (ilog2(cache_size) - CACHE_BLK_BITS); 

	assert(fs != NULL);
	assert(dir != NULL);
	assert(cache_buf != NULL);
	assert(cache_size > DYNFS_CACHE_MIN_SIZE);

	fs->cache.blk = ((struct cache_blk *)cache_buf);
	fs->cache.mask = nblk - 1;
	fs->cache.size = nblk;
	fs->cache.free = nblk;
	fs->cache.head = 0;
	fs->cache.tail = 0;
	/* just one block of size nblk in the list */
	fs->cache.seq = 0;
	fs->dir = dir;

	/* number of open files */
	fs->file_open.cnt = 0;
	/* bitmap of open files */
	fs->file_open.bmp = 0;

	return 0;
}

struct dynfs_dirent * dynfs_lookup(struct dynfs * fs, const char * path)
{
	const struct dynfs_dirent * dirent;
	int i = 0;

	dirent = &fs->dir[i];
	while (dirent->inode != 0) {
		if (strcmp(path, dirent->fname) == 0) {
			return (struct dynfs_dirent *)dirent;
		}
		dirent = &fs->dir[++i];
	}
	return NULL; 
}

/* invalidate a cache entry */
void cache_delete(struct cache * cache, struct chunk_hdr * chunk)
{
	struct cache_blk * blk;
	unsigned int offs;
	uint32_t head;
	uint32_t tail;
	uint32_t mask;
	int32_t free;

	offs = __blk2offs(cache, (struct cache_blk *)chunk);
	tail = cache->tail;
	head = cache->head;
	mask = cache->mask;
	free = cache->free;

	/* get the first entry from the tail */
	blk = &cache->blk[tail & mask];
	/* discard all the entries up to ours */
	while (tail < head) {
		if (tail == head) {
			INFS("tail == head");
			break;
		}
		blk->chunk.inode = 0;
		free += blk->chunk.size;
		if (offs == (tail & mask)) {
			tail += blk->chunk.size;
			break;
		}
		tail += blk->chunk.size;
		blk = &cache->blk[tail & mask];
	}

	cache->tail = tail;
	cache->free = free;
}

void cache_free(struct cache * cache, void * buf)
{	
	struct chunk_hdr * chunk;

	chunk = ((struct chunk_hdr *)buf - 1);
	cache_delete(cache, chunk);
}

struct chunk_hdr * cache_locate(struct cache * cache, size_t bytes, int inode)
{
	struct cache_blk * blk;
	uint32_t head;
	uint32_t tail;
	uint32_t mask;

	tail = cache->tail;
	head = cache->head;
	mask = cache->mask;

	while (tail < head) {
		/* discard old entries */
		blk = &cache->blk[tail & mask];
		if (blk->chunk.inode == inode)
			return &blk->chunk;
		tail += blk->chunk.size;
	}

	return NULL;
}

struct chunk_hdr * cache_alloc(struct cache * cache, size_t bytes, int inode)
{
	struct cache_blk * blk;
	uint32_t head;
	uint32_t tail;
	uint32_t mask;
	int32_t free;
	int size;

	tail = cache->tail;
	head = cache->head;
	mask = cache->mask;
	free = cache->free;

	size = __bytes2blk(bytes);

	if (size > cache->size) {
		/* request is too large */
		return NULL;
	}

	while ((cache->size + tail - head) < size) {
	/* discard all the entries up to ours */
		if (tail == head) {
			INFS("tail == head");
			break;
		}
		/* discard old entries */
		blk = &cache->blk[tail & mask];
		blk->chunk.inode = 0;
		free += blk->chunk.size;
		tail += blk->chunk.size;
	}

	blk = &cache->blk[head & mask];
	blk->chunk.inode = inode;
	blk->chunk.size = size;
	free -= size;

	cache->tail = tail;
	cache->head = head;
	cache->free = free;

	return &blk->chunk;
}

uint8_t * dynfs_cache_get_buffer(struct dynfs * fs, size_t bytes, int inode)
{
	struct cache * cache = &fs->cache;
	struct chunk_hdr * chunk;

	if ((chunk = cache_locate(cache, bytes, inode)) != NULL) {
		if (chunk->size < __bytes2blk(bytes)) {
			/* too small discading */
			cache_delete(cache, chunk);
		} else {
			return chunk->data;
		}
	}
	if ((chunk = cache_alloc(cache, bytes, inode)) != NULL)
		return chunk->data;
	else
		return NULL;
}

int dynfs_fopen(struct dynfs * fs, const char * path)
{
	struct dynfs_file * file;
	struct dynfs_dirent * dirent;

	if ((dirent = dynfs_lookup(fs, path)) == NULL) {
		return 0;
	}

	file->buf = dynfs_cache_get_buffer(fs, dirent->size, dirent->inode);
}

#define DYNFS_INSTANCE_MAX 1

struct dynfs dynfs_instance[DYNFS_INSTANCE_MAX];

struct dynfs * dynfs_alloc(unsigned int instance)
{
	struct dynfs * fs;

	if (instance >= DYNFS_INSTANCE_MAX)
		return NULL;

	fs = &dynfs_instance[instance];
	memset(fs, 0, sizeof(struct dynfs));

	return fs;
}

